	)
	(text_box "The 24V input does not include any fuses/polyfuses as they are added in all areas where they are \nrequired.\n\nThis will allow the rest of the circuits dependent on +24V rail to continue functioning in the event a fault/short of the +24V line used \nby those sections."
		(exclude_from_sim no)
		(at 25.4 139.7 0)
		(size 50.8 25.4)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "094aa87c-8490-433b-b765-aaf685e38d16")
	)
	(text_box "The 5V DC system is what supplies the board except for the MCU itself,\nas the system operates using the +5V USB rail.\n\nThe ground is shared accross power domains and the \"ideal diode\" is here to prevent\nbackfeeding the external +5V power supply.\n\nThe zero ohm resistor is for bypassing the CH213K if needed."
		(exclude_from_sim no)
		(at 68.58 57.15 0)
		(size 71.12 27.94)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "4253da98-3504-444a-aef5-201d5bd478af")
	)
