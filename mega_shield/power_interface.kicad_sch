	(text "Reverse Polarity Protection(50V IC + 60V_ds FET)"
		(exclude_from_sim no)
		(at 90.678 100.838 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "a7303a59-17c6-4d87-9ad1-e50e6f15b652")
	)
	(text "5V DC External Power connector"
		(exclude_from_sim no)
		(at 41.402 24.384 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "b88115e6-99d0-4b39-b272-99937920c158")
	)
	(text_box "The 24V input does not include any fuses/polyfuses as they are added in all areas where they are \nrequired.\n\nThis will allow the rest of the circuits dependent on +24V rail to continue functioning in the event a fault/short of the +24V line used \nby those sections.\n\nThe Ideal diode is setup for up to 50V reverse polarity protection. The Mosfet on and off timing is set by the R_ref and R_bias resistance values."
		(exclude_from_sim no)
		(at 12.7 139.7 0)
		(size 50.8 50.8)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "094aa87c-8490-433b-b765-aaf685e38d16")
	)
	(text_box "The 5V DC system is what supplies the board except for the MCU itself,\nas the system operates using the +5V USB rail.\n\nThe ground is shared accross power domains and the \"ideal diode\" is here to prevent\nbackfeeding the external +5V power supply.\n\nThe zero ohm resistor is for bypassing the CH213K if needed."
		(exclude_from_sim no)
		(at 68.58 57.15 0)
		(size 71.12 27.94)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "4253da98-3504-444a-aef5-201d5bd478af")
	)
